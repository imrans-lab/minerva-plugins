  "definitions": [
    {
      "schema_version": 1,
      "record_kind": "council_definition",
      "definition_id": "def-workshop-economics",
      "definition_revision": 6,
      "name": "Workshop Economics",
      "purpose": "Decide whether a one-person workshop should take on a larger recurring order, and say plainly what the decision costs.",
      "members": [
        {
          "member_id": "mem-chair",
          "member_revision": 1,
          "kind": "assistant",
          "display_name": "Chair",
          "scope": "Runs the round, reports where members disagree, and never adds a position of its own.",
          "limitations": "Has no grounding of its own; everything it reports must trace to a member contribution.",
          "grounding": []
        },
        {
          "member_id": "mem-costing",
          "member_revision": 1,
          "kind": "assistant",
          "display_name": "Unit costing",
          "scope": "Arithmetic on price, volume and the hours a job consumes. A functional advisor: it represents nobody.",
          "limitations": "Knows only the numbers it is given. Establishes nothing about the customer, the market, or what the operator wants.",
          "grounding": []
        },
        {
          "member_id": "mem-okonkwo",
          "member_revision": 3,
          "kind": "simulant",
          "display_name": "Okonkwo (capacity writing)",
          "represents": "R. Okonkwo, author of the fictional essay and letter written for this fixture",
          "scope": "Capacity and pricing for a single-operator workshop, as argued in one essay and one later correction.",
          "limitations": "Two short pieces on capacity. Establishes nothing about hiring, financing, this shop's customers, or this author's views on anything else.",
          "grounding": [
            {
              "source_id": "src-capacity-essay",
              "source_revision": 2
            },
            {
              "source_id": "src-capacity-letter",
              "source_revision": 1
            }
          ]
        }
      ],
      "seats": [
        {
          "seat_id": "seat-chair",
          "member_id": "mem-chair",
          "responsibility": "Synthesise the round and preserve disagreement.",
          "role": "chair"
        },
        {
          "seat_id": "seat-costing",
          "member_id": "mem-costing",
          "responsibility": "Say what the order does to the numbers.",
          "role": "advisor",
          "relevance_tags": [
            "pricing"
          ]
        },
        {
          "seat_id": "seat-capacity",
          "member_id": "mem-okonkwo",
          "responsibility": "Argue the capacity consequences from the captured writing.",
          "role": "advisor",
          "relevance_tags": [
            "pricing",
            "capacity"
          ]
        }
      ],
      "sources": [
        {
          "source_id": "src-capacity-essay",
          "source_revision": 2,
          "title": "What a bench can actually hold (fixture essay)",
          "author": "R. Okonkwo",
          "locator": "note: Workshop capacity essay",
          "captured_at": "2026-09-01T14:03:00Z",
          "content_hash": "sha256:0e6baff9ffd389510802b77b3b4a35ed53508fe66c469c40754be669ee08af46",
          "artifact": {
            "kind": "note",
            "ref": "note-capacity-essay",
            "label": "Workshop capacity essay"
          },
          "payload": {
            "content_type": "text/markdown",
            "byte_length": 243,
            "content_hash": "sha256:0e6baff9ffd389510802b77b3b4a35ed53508fe66c469c40754be669ee08af46",
            "inline": "A bench has one throughput, and every promise made against it is a promise against the same hours. A recurring order is not extra work; it is the removal of the freedom to say no. Price it as the loss of that freedom, not as a volume discount."
          },
          "anchors": [
            {
              "anchor_id": "anc-freedom",
              "quote": "A recurring order is not extra work; it is the removal of the freedom to say no.",
              "start": 99,
              "end": 179
            }
          ]
        },
        {
          "source_id": "src-capacity-letter",
          "source_revision": 1,
          "title": "A correction to the capacity essay (fixture letter)",
          "author": "R. Okonkwo",
          "locator": "note: Capacity essay \u2014 the author's correction",
          "captured_at": "2026-09-02T08:40:00Z",
          "content_hash": "sha256:6ff4a539ac770a5d9f41e6ddbc9d5bedd1808583a830076813f3a8a38823ad55",
          "artifact": {
            "kind": "note",
            "ref": "note-capacity-letter",
            "label": "Capacity essay \u2014 the author's correction"
          },
          "payload": {
            "content_type": "text/markdown",
            "byte_length": 318,
            "content_hash": "sha256:6ff4a539ac770a5d9f41e6ddbc9d5bedd1808583a830076813f3a8a38823ad55",
            "inline": "Two years after the essay I would add one correction. The number that matters is not the month's total but the worst week inside it, because a bench that clears fifty units in an easy week and thirty in a hard one has a capacity of thirty. Quote against the hard week or you are quoting against a bench you do not own."
          },
          "anchors": [
            {
              "anchor_id": "anc-hard-week",
              "quote": "Quote against the hard week or you are quoting against a bench you do not own.",
              "start": 240,
              "end": 318
            }
          ]
        }
      ],
      "deliberation": {
        "max_members_per_round": 4,
