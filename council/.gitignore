# Build outputs. The plugin's manifest artifact is council-plugin; `go build`
# without -o also drops a binary named after the package directory. Neither is
# ever checked in.
/council-plugin
/council

# Release packaging scratch. scripts/pack-release.sh assembles the staging tree
# and the tarball here; neither is ever checked in — CI rebuilds both from
# source on every run.
/build/
/dist/
