{
  "id": "docket",
  "name": "Docket",
  "version": "0.3.0-rc.29",
  "description": "One-shot launcher that attaches to the standalone Docket GUI or starts it detached. Requires Go 1.23 or newer and network access to official GitHub release hosts on first setup; launcher startup never downloads.",
  "price": {"amount_minor": 0, "currency": "USD"},
  "host_api_version": "1",
  "backend": {"transport": "stdio", "entrypoint": "./docket-plugin.exe", "args": []},
  "tools": [],
  "events": [],
  "setup": {
    "requires": [{"tool": "go", "min": "1.23"}],
    "steps": [
      {"type": "go_build", "package": "./", "output": "docket-plugin.exe"},
      {"type": "exec", "argv": ["./docket-plugin.exe", "prepare"], "timeout_s": 660}
    ]
  },
  "release_targets": ["linux-x86_64", "windows-x86_64", "macos-amd64", "macos-arm64"]
}
