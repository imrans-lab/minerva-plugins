# smart-remote-v2 enclosure — re-HITL cad 0.3.4
# The pcb 3D export is glTF-standard: metres, Y up. mesh() converts to mm, Z up.
# Board frame after conversion: x 0..90, y -100..0, z 0 (underside) .. 1.6 (top face);
# tallest part reaches z 10.1 (the U1S devkit sockets), header pins hang to z -1.6.
# Left of the board = small x. SW1/SW2 are the vertical pair on the left edge, SW3/SW4 the horizontal pair at y -60.
board = mesh("smart-remote-v2.glb", units="m", up="y")

# ---- off-board parts (stand-in meshes from datasheet dimensions), posed in the board frame
# ESP32-S3 devkit plugs into the U1S_A/U1S_B sockets (x 32.3..57.7, y -64..-8.2, top at z 10.1); USB-C end faces y=0
esp = translate([45, -36.9, 10.1], mesh("parts/esp32_s3_devkitc1.glb", units="mm", up="z"))
# OLED beside the SW1/SW2 pair, hanging under the ceiling, display up through a window.
# The 27 mm module does not fit between the two keycaps (26.4 mm), so it sits just right of the button line.
ceil_z = 22       # 7 mm over the devkit's top (z 15) so it can be pushed onto its sockets
oled_x = 24.5
oled_y = -25.75
oled = translate([oled_x, oled_y, ceil_z - 2.8], mesh("parts/oled_096.stl", units="mm", up="z"))
# thumbstick below SW3/SW4 in the bottom-left corner (its pcb clears J3 at z 7.2); stick rises through a dome
stick_x = 21
stick_y = -84
stick = translate([stick_x, stick_y, 9], mesh("parts/joystick_ky023.glb", units="mm", up="z"))
# speaker under the ceiling at the upper right of the shell, grille above it; mic U3 sits at (45,-92) on the board
spk_x = 72
spk_y = -16
speaker = translate([spk_x, spk_y, ceil_z - 5.5], mesh("parts/speaker_28mm.stl", units="mm", up="z"))
# 4xAA holder under the board in the bottom shell, resting on the closed battery door (door top at z -22.7)
batt = translate([45, -52, -22.7], mesh("parts/holder_4xaa_2x2.stl", units="mm", up="z"))

holes = [[4, -4], [86, -4], [4, -96], [86, -96]]
# tactile switch centres (actuator tops at z 6.6)
switches = [[6, -9.5], [5.5, -42], [22, -60.5], [8, -60.5]]

# ---- print settings: PLA on an FDM printer. Holes print ~0.42 mm under size, so every CLEARANCE hole gets
# print_clear added to its diameter. Thread pilots do NOT: a post drilled at exactly the screw diameter prints
# slightly under and the machine thread cuts its own grip.
print_clear = 0.42
screw_d = 3
screw_clear_d = 3.4 + print_clear    # ISO 273 medium clearance for M3, plus the printer's undersize
pilot_r = screw_d / 2                # thread-forming pilot in the posts: no clearance on purpose

wall = 2
side = 2          # air between board edge and inner wall
gap = 0.3         # parting gap between the halves
wire_bay = 12     # extra length past the board's y=-100 edge: room for the battery leads and connector to be plugged
x0 = 0 - side - wall
y0 = -100 - side - wall - wire_bay
ox = 90 + 2*side + 2*wall
oy = 100 + 2*side + 2*wall + wire_bay
ix = ox - 2*wall
iy = oy - 2*wall

# ---- outer form: one blank for both halves, corner and top edges rounded, then split at the parting line.
# The board's sharp corners sit 4 mm inside the outer corner, so the vertical fillet cannot exceed ~4.8 mm
# without breaching the 2 mm wall; a rounder hand-feel needs more corner clearance on the board.
floor_top = -22
part_z = 4
blank = translate([x0, y0, floor_top - wall], cube(ox, oy, ceil_z + wall - floor_top + wall))
fillet blank, [1, 3, 5, 7, 2, 6, 10, 12], r=4
huge = 200
bottom = blank - translate([x0 - 1, y0 - 1, part_z], cube(ox + 2, oy + 2, huge))
bottom = bottom - translate([x0 + wall, y0 + wall, floor_top], cube(ix, iy, part_z - floor_top + 1))
# standoffs carry the board underside (z=0); the screw passes up through them
for p in holes:
    bottom = bottom + translate([p[0], p[1], floor_top], cylinder(h=0 - floor_top, r=3))
    bottom = bottom - translate([p[0], p[1], floor_top - wall - 1], cylinder(h=0 - floor_top + wall + 2, r=screw_clear_d / 2))
# battery door, hook-and-snap (the classic TV-remote cover, printable in PLA):
#   two rigid hooks on the -y edge slide into slots under the floor margin; a 1 mm cantilever tab on the +y edge
#   carries a 0.6 mm bump that snaps behind a 1.2 mm ledge. To open: press the tab through the finger recess, lift, unhook.
door_x = 12
door_y = -82.5
door_w = 66
door_l = 61
floor_z = floor_top - wall           # underside of the floor (z -24)
door_t = 1.3                         # door plate thickness; the floor is 2, so 0.7 mm of floor stays over the hooks
bottom = bottom - translate([door_x, door_y, floor_z - 1], cube(door_w, door_l, wall + 2))
# hook slots in the -y margin: 0.8 mm hooks + print clearance, 4 mm deep
for hx in [door_x + 10, door_x + door_w - 22]:
    bottom = bottom - translate([hx - print_clear/2, door_y - 4 - print_clear/2, floor_z - 1], cube(12 + print_clear, 4 + print_clear, 1 + 0.8 + print_clear))
# snap pocket in the +y margin: a 1.2 mm ledge the bump passes under, then a deeper pocket the bump springs up into
tab_x = door_x + door_w/2
bottom = bottom - translate([tab_x - 7, door_y + door_l - 0.1, floor_z - 1], cube(14, 1.3, 1 + 1.0 + print_clear))
bottom = bottom - translate([tab_x - 7, door_y + door_l + 1.2, floor_z - 1], cube(14, 2.6, 1 + 1.6 + print_clear))
# finger recess beside the tab so a nail can press it down
bottom = bottom - translate([tab_x - 6, door_y + door_l + 1.2, floor_z - 1], cube(12, 6, 1 + 0.6))
# the door itself
door = translate([door_x + print_clear/2, door_y + print_clear/2, floor_z], cube(door_w - print_clear, door_l - print_clear, door_t))
for hx in [door_x + 10, door_x + door_w - 22]:
    door = door + translate([hx, door_y - 4 + print_clear/2, floor_z], cube(12, 4.2, 0.8))
door = door + translate([tab_x - 6, door_y + door_l - 10, floor_z], cube(12, 10 + 3.5, 1.0))
door = door - translate([tab_x - 6.5, door_y + door_l - 10, floor_z - 1], cube(0.5, 10, 3))
door = door - translate([tab_x + 6, door_y + door_l - 10, floor_z - 1], cube(0.5, 10, 3))
door = door + translate([tab_x - 6, door_y + door_l + 1.6, floor_z + 1.0], cube(12, 1.6, 0.6))

# finger detents: a 4 mm grip pad along each side wall with a channel scooped 3 mm into it, running along y
detent_cx = [x0 - 4 - 7, x0 + ox + 4 + 7]
for gx in [x0 - 4, x0 + ox]:
    bottom = bottom + translate([gx, -85, floor_top - wall], cube(4, 70, part_z - floor_top + wall))
for cx in detent_cx:
    bottom = bottom - translate([cx, -50, -9], rotate([90, 0, 0], cylinder(h=70, r=10, center=true)))

# ---- top half: the blank above the parting gap, open underneath
top_z0 = part_z + gap
top = blank - translate([x0 - 1, y0 - 1, top_z0 - huge], cube(ox + 2, oy + 2, huge))
top = top - translate([x0 + wall, y0 + wall, top_z0 - 1], cube(ix, iy, ceil_z - top_z0 + 1))
for gx in [x0 - 4, x0 + ox]:
    top = top + translate([gx, -85, top_z0], cube(4, 70, ceil_z + wall - top_z0))
for cx in detent_cx:
    top = top - translate([cx, -50, -9], rotate([90, 0, 0], cylinder(h=70, r=10, center=true)))
# posts come down from the ceiling to the board top face (z=1.6); M3 thread-forming pilot 2.5 mm, 8 deep
for p in holes:
    top = top + translate([p[0], p[1], 1.6], cylinder(h=ceil_z - 1.6, r=3))
    top = top - translate([p[0], p[1], 1.6 - 1], cylinder(h=8 + 1, r=pilot_r))
# SW1 (y up to -6.4, z up to 6.6) runs into the post at (4,-4): notch the post flat at y=-5.9 over SW1's height
top = top - translate([-1, -9, 1.6], cube(9, 3.1, 5.5))
# two USB-C windows in the y=0 end wall, 13 mm apart, at the devkit's connector height
for dx in [-6.5, 6.5]:
    top = top - translate([45 + dx - 5 - print_clear/2, 1, 11 - print_clear/2], cube(10 + print_clear, 4, 5 + print_clear))
# OLED window
top = top - translate([oled_x - 12, oled_y - 12, ceil_z - 1], cube(24, 24, wall + 2))
# thumbstick dome: raised ring over the stick, hollow, with the stick hole through its roof
top = top + translate([stick_x, stick_y, ceil_z], cylinder(h=12, r=18))
top = top - translate([stick_x, stick_y, ceil_z - 1], cylinder(h=11, r=16))
top = top - translate([stick_x, stick_y, ceil_z + 9], cylinder(h=5, r=9 + print_clear/2))
# speaker grille: 5x5 pinholes over the cone
for gx in [-8, -4, 0, 4, 8]:
    for gy in [-8, -4, 0, 4, 8]:
        top = top - translate([spk_x + gx, spk_y + gy, ceil_z - 1], cylinder(h=wall + 2, r=0.8))
# mic tube: a hollow post from the ceiling down to 1 mm above the MEMS mic U3 (top z 2.6), pinholes through its roof
top = top + translate([45, -92, 3.6], cylinder(h=ceil_z - 3.6, r=3))
top = top - translate([45, -92, 3.6 - 1], cylinder(h=ceil_z - 3.6 + 1, r=1.2))
for mx in [-0.7, 0, 0.7]:
    top = top - translate([45 + mx, -92, ceil_z - 1], cylinder(h=wall + 2, r=0.35))
# keycaps: a plunger through a hole in the ceiling, resting on the switch actuator, with a flange under the ceiling that keeps it in
caps = translate([switches[0][0], switches[0][1], 6.8], cylinder(h=0.1, r=0.1))
for s in switches:
    top = top - translate([s[0], s[1], ceil_z - 1], cylinder(h=wall + 2, r=3 + print_clear/2))
    caps = caps + translate([s[0], s[1], 6.8], cylinder(h=ceil_z + 3 - 6.8, r=2.7))
    caps = caps + translate([s[0], s[1], ceil_z - 2.8], cylinder(h=1.5, r=4))

enclosure = bottom + top + door + caps
enclosure