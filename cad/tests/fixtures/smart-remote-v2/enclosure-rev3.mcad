# smart-remote-v2 enclosure — rev 3: flat remote with a gentle crown and a raised centre section
# The pcb 3D export is glTF-standard (metres, Y up); mesh() converts to mm, Z up.
# Board frame after conversion: x 0..90, y -100..0, z 0 (underside) .. 1.6 (top face).
# Measured with minerva_cad_references / find_holes: M3 holes at (4,-4) (86,-4) (4,-96) (86,-96);
# switch tops z 6.6; U1S devkit sockets x 32.3..57.7 y -64..-8.2 top z 10.1; J2 (OLED) and J3 (stick)
# on the left at z 7.2; J5 (battery) at the y=-100 edge on the right; right-side parts under z 3.5.
board = mesh("smart-remote-v2.glb", units="m", up="y")

# ---- print settings: PLA on an FDM printer. Holes print ~0.42 mm under size, so every CLEARANCE hole gets
# print_clear added to its diameter. Thread pilots do NOT: the machine thread cuts its own grip.
print_clear = 0.42
screw_d = 3
screw_clear_d = 3.4 + print_clear
pilot_r = screw_d / 2
m2_pilot_r = 1.0
m25_pilot_r = 1.25

# ---- off-board parts (stand-in meshes from datasheet dimensions), posed in the board frame
# ESP32-S3 devkit in the U1S sockets, USB-C end toward y=0; top face z 15
esp = translate([45, -36.9, 10.1], mesh("parts/esp32_s3_devkitc1.glb", units="mm", up="z"))
# OLED beside SW1/SW2, above the devkit's left edge, screwed from below to posts under the raised section
oled_x = 27.5
oled_y = -28
oled_z = 17
oled = translate([oled_x, oled_y, oled_z], mesh("parts/oled_096.stl", units="mm", up="z"))
oled_hole = 23.5 / 2
# thumbstick bottom-left over its own connector J3, turned 90 degrees so its 34 mm side runs along x;
# housing 16 mm square and 10 mm tall above its pcb, cap dia 25 from 32 to 42 above the pcb
stick_x = 25.2
stick_y = -84
stick_z = 8.5
stick = translate([stick_x, stick_y, stick_z], rotate([0, 0, 90], mesh("parts/joystick_ky023.glb", units="mm", up="z")))
stick_hx = 26.5 / 2
stick_hy = 20.5 / 2
# speaker on the low right side of the board (nothing taller than 3.5 there), held by a collar from the top skin
spk_x = 76     # collar (r 16.5) stays 1.8 clear of the devkit's right edge at x 57.7
spk_y = -50
spk_z = 4.6    # 1 mm over the inductor L1 (top z 3.5)
speaker = translate([spk_x, spk_y, spk_z], mesh("parts/speaker_28mm.stl", units="mm", up="z"))
# 4xAA holder (62 x 57 x 17.25) lying flat in a tail bay behind the board's y=-100 edge, plug room for J5 in front
plug_room = 8
batt_y = -100 - plug_room - 28.5
batt_z = -8.7    # the holder rests on the battery door, 0.7 below the floor
batt = translate([45, batt_y, batt_z], mesh("parts/holder_4xaa_2x2.stl", units="mm", up="z"))

holes = [[4, -4], [86, -4], [4, -96], [86, -96]]
switches = [[6, -9.5], [5.5, -42], [22, -60.5], [8, -60.5]]


wall = 2
side = 2          # air between board edge and inner wall
gap = 0.3         # parting gap between the halves
tail = plug_room + 57 + 4        # bay behind the board: plug room for J5, the holder, slack
x0 = 0 - side - wall
y0 = -100 - side - wall - tail
ox = 90 + 2*side + 2*wall
oy = 100 + 2*side + 2*wall + tail
ix = ox - 2*wall
iy = oy - 2*wall
cx = x0 + ox / 2
cy = y0 + oy / 2
huge = 200
floor_top = -8                  # one flat floor: header pins hang to z -1.6, the holder lies in the tail
under = floor_top - wall
part_z = 4
top_z0 = part_z + gap
plate_z = 13                    # top skin at the two ends of the body
crown = 4.8                     # the skin rises this much at mid-length: a cylinder of radius crown_r along x
crown_r = 800

# ---- footprint: one rounded-corner prism for both halves, everything is clipped to it
fp = translate([x0, y0, -20], cube(ox, oy, 80))
fillet fp, [1, 3, 5, 7], r=4
outside_fp = translate([x0 - 10, y0 - 10, -30], cube(ox + 20, oy + 20, 100)) - fp

# ---- bottom tray: flat underside, board on four bosses, battery door under the tail
bottom = fp - translate([x0 - 1, y0 - 1, part_z], cube(ox + 2, oy + 2, huge))
bottom = bottom - translate([x0 - 1, y0 - 1, -21], cube(ox + 2, oy + 2, under + 21))
bottom = bottom - translate([x0 + wall, y0 + wall, floor_top], cube(ix, iy, part_z - floor_top + 1))
# bosses carry the board underside (z=0); M3 x 16 from below, head counterbored flush with the underside
for p in holes:
    bottom = bottom + translate([p[0], p[1], floor_top], cylinder(h=0 - floor_top, r=4.5))
    bottom = bottom - translate([p[0], p[1], under - 1], cylinder(h=0 - under + 2, r=screw_clear_d / 2))
    bottom = bottom - translate([p[0], p[1], under - 1], cylinder(h=1 + 2.5, r=3.2 + print_clear / 2))

# battery door, hook-and-snap (the classic TV-remote cover, printable in PLA):
#   two rigid hooks on the -y edge slide into slots under the floor margin; a 1 mm cantilever tab on the +y edge
#   carries a 0.6 mm bump that snaps behind a 1.2 mm ledge. To open: press the tab through the finger recess, lift, unhook.
door_x = 12
door_y = -166
door_w = 66
door_l = 61
floor_z = under
door_t = 1.3
bottom = bottom - translate([door_x, door_y, floor_z - 1], cube(door_w, door_l, wall + 2))
for hx in [door_x + 10, door_x + door_w - 22]:
    bottom = bottom - translate([hx - print_clear/2, door_y - 4 - print_clear/2, floor_z - 1], cube(12 + print_clear, 4 + print_clear, 1 + 0.8 + print_clear))
tab_x = door_x + door_w/2
bottom = bottom - translate([tab_x - 7, door_y + door_l - 0.1, floor_z - 1], cube(14, 1.3, 1 + 1.0 + print_clear))
bottom = bottom - translate([tab_x - 7, door_y + door_l + 1.2, floor_z - 1], cube(14, 2.6, 1 + 1.6 + print_clear))
bottom = bottom - translate([tab_x - 6, door_y + door_l + 1.2, floor_z - 1], cube(12, 6, 1 + 0.6))
door = translate([door_x + print_clear/2, door_y + print_clear/2, floor_z], cube(door_w - print_clear, door_l - print_clear, door_t))
for hx in [door_x + 10, door_x + door_w - 22]:
    door = door + translate([hx, door_y - 4 + print_clear/2, floor_z], cube(12, 4.2, 0.8))
door = door + translate([tab_x - 6, door_y + door_l - 10, floor_z], cube(12, 10 + 3.5, 1.0))
door = door - translate([tab_x - 6.5, door_y + door_l - 10, floor_z - 1], cube(0.5, 10, 3))
door = door - translate([tab_x + 6, door_y + door_l - 10, floor_z - 1], cube(0.5, 10, 3))
door = door + translate([tab_x - 6, door_y + door_l + 1.6, floor_z + 1.0], cube(12, 1.6, 0.6))

# ---- top shell: a gently crowned plate with a raised section over the OLED, devkit and thumbstick
crown_cyl = translate([cx, cy, plate_z + crown - crown_r], rotate([0, 90, 0], cylinder(h=ox + 40, r=crown_r, center=true)))
crown_in = translate([0, 0, 0 - wall], crown_cyl)
crown_plus = translate([0, 0, 1.5], crown_cyl)
big = translate([x0 - 10, y0 - 10, top_z0 - 1], cube(ox + 20, oy + 20, 60))
# the raised section: a flat-topped loft, walls sloping in from the plate; its inner cavity is the same loft
# 2 mm smaller, so the skin stays 2 thick on the flanks
hump_x = 30
hump_y = -50
hump = loft:
    z=11: rect(72, 112)
    z=19: rect(60, 102)
    z=23.5: rect(54, 98)
hump = translate([hump_x, hump_y, 0], hump) - outside_fp
hump_in = loft:
    z=9: rect(68, 108)
    z=21.5: rect(50, 94)
hump_in = translate([hump_x, hump_y, 0], hump_in)
hump_plus = translate([0, 0, 1.5], hump)

top = fp - translate([x0 - 1, y0 - 1, top_z0 - huge], cube(ox + 2, oy + 2, huge))
top = top - (big - crown_cyl)
top = top + hump
cavity = translate([x0 + wall, y0 + wall, top_z0 - 1], cube(ix, iy, 60)) - (big - crown_in)
top = top - cavity - hump_in
# "outside the skin": everything above the plate crown and the raised section; posts are clipped to it once
outside = translate([x0 - 10, y0 - 10, 9], cube(ox + 20, oy + 20, 60)) - crown_cyl - hump
outside_plus = translate([x0 - 10, y0 - 10, 9], cube(ox + 20, oy + 20, 60)) - crown_plus - hump_plus

# everything that hangs from the skin is built as tall cylinders, unioned, and clipped ONCE to the outer surface
hang = translate([holes[0][0], holes[0][1], 1.6], cylinder(h=1, r=0.1))
# shell posts from the board top face (z=1.6); M3 pilots 9 deep, the screw comes up from the boss below
post_xy = holes
for p in post_xy:
    hang = hang + translate([p[0], p[1], 1.6], cylinder(h=48, r=3))
# OLED posts land on the module's pcb top face (pcb 1.6 thick), M2 screws from below
for dx in [-oled_hole, oled_hole]:
    for dy in [-oled_hole, oled_hole]:
        hang = hang + translate([oled_x + dx, oled_y + dy, oled_z + 1.6], cylinder(h=48, r=2.5))
# thumbstick posts on its pcb top face, M2.5 screws from below
for dx in [-stick_hx, stick_hx]:
    for dy in [-stick_hy, stick_hy]:
        hang = hang + translate([stick_x + dx, stick_y + dy, stick_z + 1.6], cylinder(h=48, r=2.8))
# speaker collar: a ring around the 28 mm speaker, from just above the board parts up to the skin
hang = hang + translate([spk_x, spk_y, spk_z + 0.6], cylinder(h=48, r=16.5))   # ring bottom 1.1 over C12 (top z 4.1)
# mic tube over the MEMS mic U3 (top z 2.6)
mic_x = 46
mic_y = -92
hang = hang + translate([mic_x, mic_y, 3.8], cylinder(h=48, r=2.5))
# keycap guide sleeves
for s in switches:
    hang = hang + translate([s[0], s[1], 8.6], cylinder(h=48, r=4.4))
hang = hang - outside
top = top + hang

# bores and windows through the hanging parts and the skin
for p in post_xy:
    top = top - translate([p[0], p[1], 1.6 - 1], cylinder(h=9 + 1, r=pilot_r))
# SW1 (y up to -6.45) runs into the post at (4,-4): notch the post flat at y=-5.9 over SW1's height
top = top - translate([-1, -9, 1.6], cube(9, 3.1, 6))
for dx in [-oled_hole, oled_hole]:
    for dy in [-oled_hole, oled_hole]:
        top = top - translate([oled_x + dx, oled_y + dy, oled_z + 1.6 - 1], cylinder(h=5, r=m2_pilot_r))
top = top - translate([oled_x - 11, oled_y - 11, oled_z + 2], cube(22, 22, 40))
for dx in [-stick_hx, stick_hx]:
    for dy in [-stick_hy, stick_hy]:
        top = top - translate([stick_x + dx, stick_y + dy, stick_z + 1.6 - 1], cylinder(h=6, r=m25_pilot_r))
# the stick's stem passes through the skin; its housing stays under it
top = top - translate([stick_x, stick_y, 20.5], cylinder(h=40, r=6.5 + print_clear/2))
# speaker pocket inside the collar, stopping under the skin so the grille has a roof to sit in
top = top - translate([spk_x, spk_y, spk_z - 0.1], cylinder(h=10, r=14 + print_clear/2))
for gx in [-6, 0, 6]:
    for gy in [-6, 0, 6]:
        top = top - translate([spk_x + gx, spk_y + gy, spk_z + 5.5], cylinder(h=40, r=1.2))
top = top - translate([mic_x, mic_y, 3.8 - 1], cylinder(h=45, r=1.0))
# two USB-C windows in the y=0 end wall, 13 mm apart, at the devkit's connector height
for dx in [-6.5, 6.5]:
    top = top - translate([45 + dx - 5 - print_clear/2, -1, 11 - print_clear/2], cube(10 + print_clear, 7, 5 + print_clear))
for s in switches:
    top = top - translate([s[0], s[1], 8.6 - 1], cylinder(h=45, r=3 + print_clear/2))

# keycaps: a plunger riding in its sleeve, a foot flange so it cannot fall out, top clipped 1.5 mm proud of the skin
caps = translate([switches[0][0], switches[0][1], 6.8], cylinder(h=1, r=0.1))
for s in switches:
    caps = caps + translate([s[0], s[1], 6.8], cylinder(h=40, r=2.7))
    caps = caps + translate([s[0], s[1], 6.8], cylinder(h=1.5, r=4))
caps = caps - outside_plus

enclosure = bottom + top + door + caps
enclosure
