# Embedded python runtime bundles land here. Built by
# scripts/build-python-runtime-bundle.sh and consumed by go:embed in
# embed_<triple>.go. The bundles are large (~150-250MB) and per-platform;
# CI rebuilds them per matrix leg.  Empty placeholders for every target are
# tracked so go:embed can compile in a fresh clone; real bundle output is
# ignored by the size-aware rules below.

*.tar.zst
*.sha256
!runtime-bundle-linux-x86_64.tar.zst
!runtime-bundle-linux-x86_64.sha256
!runtime-bundle-linux-arm64.tar.zst
!runtime-bundle-linux-arm64.sha256
!runtime-bundle-macos-amd64.tar.zst
!runtime-bundle-macos-amd64.sha256
!runtime-bundle-macos-arm64.tar.zst
!runtime-bundle-macos-arm64.sha256
!runtime-bundle-windows-x86_64.tar.zst
!runtime-bundle-windows-x86_64.sha256
!.gitignore
