{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-remote.local/protocol/v1/plugin/choices.json",
  "title": "choices",
  "description": "Open a pick-one list for an agent question.",
  "type": "object",
  "properties": {
    "type": {
      "const": "choices"
    },
    "choice_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "prompt": {
      "$ref": "../common.json#/$defs/short_text"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  },
  "required": [
    "type",
    "choice_id",
    "prompt",
    "items"
  ],
  "additionalProperties": false
}
