{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-remote.local/protocol/v1/device/hello.json",
  "title": "hello",
  "description": "First message on every connection.",
  "type": "object",
  "properties": {
    "type": {
      "const": "hello"
    },
    "proto": {
      "const": 1
    },
    "token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "WiFi MAC, lowercase hex."
    },
    "fw": {
      "type": "string",
      "maxLength": 40
    }
  },
  "required": [
    "type",
    "proto",
    "token",
    "device_id",
    "fw"
  ],
  "additionalProperties": false
}
