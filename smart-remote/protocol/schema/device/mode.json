{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-remote.local/protocol/v1/device/mode.json",
  "title": "mode",
  "description": "Mode change; mouse is followed by a normal close.",
  "type": "object",
  "properties": {
    "type": {
      "const": "mode"
    },
    "mode": {
      "enum": [
        "voice",
        "mouse"
      ]
    }
  },
  "required": [
    "type",
    "mode"
  ],
  "additionalProperties": false
}
