{
  "id": "smart_remote",
  "name": "Smart Remote",
  "version": "0.1.0",
  "host_api_version": "1",
  "release_targets": ["linux-x86_64", "macos-arm64", "macos-amd64", "windows-x86_64"],
  "backend": {
    "transport": "stdio",
    "entrypoint": "./smart-remote-plugin",
    "args": []
  },
  "ui": {
    "panels": [],
    "ipc_messages": []
  },
  "editor_items": [],
  "events": [],
  "tools": [],
  "permissions": {
    "host_capabilities": [],
    "host_events": ["chat.turn_completed", "chat.directory_changed"],
    "network": {
      "mode": "unrestricted"
    }
  },
  "autostart": false,
  "auto_reload": false
}
