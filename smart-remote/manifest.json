{
  "id": "smart_remote",
  "name": "Smart Remote",
  "version": "0.1.0",
  "host_api_version": "1",
  "release_targets": [
    "linux-x86_64",
    "macos-arm64",
    "macos-amd64",
    "windows-x86_64"
  ],
  "backend": {
    "transport": "stdio",
    "entrypoint": "./smart-remote-plugin",
    "args": []
  },
  "ui": {
    "panels": [],
    "ipc_messages": []
  },
  "editor_items": [],
  "events": [],
  "tools": [
    {
      "name": "minerva_smart_remote_ble_probe",
      "description": "Scan and authenticate a remote in setup, without WiFi writes. start returns immediately; poll status or cancel using operation_id. Read the six-digit code from the OLED; never put it in logs.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "status",
              "cancel"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^SR2-[0-9A-F]{4}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "operation_id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  ],
  "permissions": {
    "host_capabilities": [
      "host.audio",
      "host.chat.active",
      "host.chat.input",
      "host.speech_log"
    ],
    "host_events": [
      "chat.active_changed",
      "chat.turn_completed",
      "voice.audio",
      "voice.transcript",
      "speech_log.changed"
    ],
    "network": {
      "mode": "unrestricted"
    }
  },
  "autostart": false,
  "auto_reload": false,
  "description": "Bridge a Smart Remote V2 to Minerva over the local network. BLE authentication probe available; pairing panel follows separately. Linux source installation requires libdbus-1-dev and pkg-config.",
  "price": {
    "amount_minor": 0,
    "currency": "USD"
  },
  "setup": {
    "requires": [
      {
        "tool": "cargo",
        "min": "1.93"
      }
    ],
    "steps": [
      {
        "type": "cargo_build",
        "manifest_dir": ".",
        "artifact": "target/release/smart-remote-plugin"
      },
      {
        "type": "copy",
        "from": "target/release/smart-remote-plugin",
        "to": "smart-remote-plugin"
      }
    ]
  }
}
