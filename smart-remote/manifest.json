{
  "id": "smart_remote",
  "name": "Smart Remote",
  "version": "0.1.2",
  "host_api_version": "2",
  "log_stderr": true,
  "release_targets": [
    "linux-x86_64",
    "macos-universal",
    "windows-x86_64"
  ],
  "backend": {
    "transport": "stdio",
    "entrypoint": "./smart-remote-plugin",
    "args": []
  },
  "ui": {
    "panels": [
      {
        "name": "smart_remote_pairing",
        "kind": "godot_scene",
        "entry_scene": "ui/PairingPanel.tscn",
        "scripts": [
          "ui/pairing_panel.gd"
        ],
        "ipc_channels": [
          "minerva_smart_remote_pairing"
        ],
        "save_mode": "none"
      }
    ],
    "ipc_messages": [
      "minerva_smart_remote_pairing"
    ]
  },
  "editor_items": [
    {
      "id": "open_pairing",
      "name": "Pair Smart Remote",
      "panel": "smart_remote_pairing",
      "default_filename": "pairing.smartremote"
    }
  ],
  "events": [],
  "tools": [
    {
      "name": "minerva_smart_remote_ble_probe",
      "description": "Scan and authenticate a remote in setup, without WiFi writes. start returns immediately; poll status or cancel using operation_id. Read the six-digit code from the OLED; never put it in logs.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "status",
              "cancel"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "operation_id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "minerva_smart_remote_pairing",
      "description": "Complete owner-entered BLE pairing. start scans/authenticates and returns immediately; describe/status report redacted state, apply supplies WiFi and Minerva address at awaiting_wifi, cancel stops monitoring. Never send live credentials through an agent.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "status",
              "cancel",
              "describe",
              "apply"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "operation_id": {
            "type": "integer",
            "minimum": 1
          },
          "ssid": {
            "type": "string",
            "maxLength": 44,
            "description": "Selected network SSID bytes in base64url without padding."
          },
          "password": {
            "type": "string",
            "maxLength": 64
          },
          "host": {
            "type": "string",
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  ],
  "permissions": {
    "host_capabilities": [
      "host.audio",
      "host.chat.active",
      "host.chat.input",
      "host.speech_log"
    ],
    "host_events": [
      "chat.active_changed",
      "chat.turn_completed",
      "voice.audio",
      "voice.transcript",
      "speech_log.changed"
    ],
    "network": {
      "mode": "unrestricted"
    }
  },
  "autostart": false,
  "auto_reload": false,
  "description": "Bridge a Smart Remote V2 to Minerva over the local network. Pair through the native owner-entered setup panel. Linux source installation requires libdbus-1-dev and pkg-config.",
  "price": {
    "amount_minor": 0,
    "currency": "USD"
  },
  "setup": {
    "requires": [
      {
        "tool": "cargo",
        "min": "1.93"
      }
    ],
    "steps": [
      {
        "type": "cargo_build",
        "manifest_dir": ".",
        "artifact": "target/release/smart-remote-plugin"
      },
      {
        "type": "copy",
        "from": "target/release/smart-remote-plugin",
        "to": "smart-remote-plugin"
      }
    ]
  }
}
