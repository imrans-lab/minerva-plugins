{
  "id": "sheets",
  "name": "Sheets",
  "version": "0.1.0",
  "description": "Staging spreadsheet editor for Minerva, extracted alongside the builtin. This skeleton opens an empty panel for development; spreadsheet editing, imports and persistence arrive in later slices. Source installs require Go 1.25 or newer; archives include the backend.",
  "host_api_version": "2",
  "release_targets": [
    "linux-x86_64",
    "linux-arm64",
    "macos-universal",
    "windows-x86_64"
  ],
  "backend": {
    "transport": "stdio",
    "entrypoint": "./sheets-plugin",
    "args": []
  },
  "setup": {
    "requires": [
      {
        "tool": "go",
        "min": "1.25"
      }
    ],
    "steps": [
      {
        "type": "go_build",
        "package": "./",
        "output": "sheets-plugin"
      }
    ]
  },
  "tools": [
    {
      "name": "minerva_sheets_create_editor",
      "executor": "backend",
      "description": "Staging creation stub. Returns sheets_staging until the spreadsheet domain is installed.",
      "input_schema": {
        "properties": {
          "csv_content": {
            "description": "Optional initial CSV content to populate the spreadsheet",
            "type": "string"
          },
          "file_path": {
            "description": "Optional file path to load (CSV, TSV, XLSX, or .minsheet)",
            "type": "string"
          },
          "name": {
            "description": "Display name for the spreadsheet tab",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    }
  ],
  "ui": {
    "panels": [
      {
        "name": "sheets_panel",
        "kind": "godot_scene",
        "entry_scene": "ui/SheetsPanel.tscn",
        "scripts": [
          "ui/SheetsPanel.gd",
          "ui/sheet_registry.gd",
          "ui/domain/CellsCanvas.gd",
          "ui/domain/ChartCanvas.gd",
          "ui/domain/ChartRenderer.gd",
          "ui/domain/ColumnHeaders.gd",
          "ui/domain/ExcelHandler.gd",
          "ui/domain/FormulaEngine.gd",
          "ui/domain/RowHeaders.gd",
          "ui/domain/SpreadsheetAutoFilter.gd",
          "ui/domain/SpreadsheetAutoFilterActions.gd",
          "ui/domain/SpreadsheetAutoFilterPopup.gd",
          "ui/domain/SpreadsheetAutoFilterUI.gd",
          "ui/domain/SpreadsheetCell.gd",
          "ui/domain/SpreadsheetChart.gd",
          "ui/domain/SpreadsheetData.gd",
          "ui/domain/SpreadsheetEditor.gd",
          "ui/domain/SpreadsheetFileHandler.gd",
          "ui/domain/SpreadsheetHistory.gd",
          "ui/domain/SpreadsheetRowGeometry.gd"
        ],
        "file_extensions": [
          ".minsheet",
          ".csv",
          ".tsv",
          ".xlsx"
        ],
        "save_mode": "host_owned",
        "ipc_channels": [
          "sheets.serialize",
          "sheets.deserialize",
          "sheets.collect_export",
          "sheets.apply_export"
        ],
        "file_actions": [
          "open",
          "import",
          "create"
        ]
      }
    ],
    "ipc_messages": [
      "sheets.serialize",
      "sheets.deserialize",
      "sheets.collect_export",
      "sheets.apply_export"
    ]
  },
  "editor_items": [
    {
      "id": "new_minsheet",
      "name": "New Spreadsheet",
      "panel": "sheets_panel",
      "default_filename": "untitled.minsheet"
    }
  ],
  "capabilities": [
    "project_state",
    "host_owned_save",
    "project_export"
  ],
  "permissions": {
    "host_capabilities": [],
    "filesystem": {
      "mode": "none",
      "paths": []
    },
    "network": {
      "mode": "none"
    }
  },
  "autostart": false,
  "auto_reload": false,
  "price": {
    "amount_minor": 0,
    "currency": "USD"
  },
  "project_file": {
    "serialize_channel": "sheets.serialize",
    "deserialize_channel": "sheets.deserialize"
  },
  "project_export": {
    "collect_channel": "sheets.collect_export",
    "apply_channel": "sheets.apply_export"
  }
}
