{
  "id": "sheets",
  "name": "Sheets",
  "version": "0.1.0",
  "description": "Spreadsheet editor with formulas, charts and filters. Staging extraction.",
  "host_api_version": "2",
  "release_targets": [
    "linux-x86_64",
    "linux-arm64",
    "macos-universal",
    "windows-x86_64"
  ],
  "backend": {
    "transport": "stdio",
    "entrypoint": "./sheets-plugin",
    "args": []
  },
  "setup": {
    "requires": [
      {
        "tool": "go",
        "min": "1.25"
      }
    ],
    "steps": [
      {
        "type": "go_build",
        "package": "./",
        "output": "sheets-plugin"
      }
    ]
  },
  "tools": [
    {
      "name": "minerva_sheets_create_editor",
      "executor": "backend",
      "description": "Staging creation stub. Returns sheets_staging until the spreadsheet domain is installed.",
      "input_schema": {
        "properties": {
          "csv_content": {
            "description": "Optional initial CSV content to populate the spreadsheet",
            "type": "string"
          },
          "file_path": {
            "description": "Optional file path to load (CSV, TSV, XLSX, or .minsheet)",
            "type": "string"
          },
          "name": {
            "description": "Display name for the spreadsheet tab",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    }
  ],
  "ui": {
    "panels": [
      {
        "name": "sheets_panel",
        "kind": "godot_scene",
        "entry_scene": "ui/SheetsPanel.tscn",
        "scripts": [
          "ui/SheetsPanel.gd"
        ],
        "file_extensions": [],
        "save_mode": "none",
        "ipc_channels": []
      }
    ],
    "ipc_messages": []
  },
  "editor_items": [
    {
      "id": "new_minsheet",
      "name": "New Spreadsheet",
      "panel": "sheets_panel",
      "default_filename": "untitled.minsheet"
    }
  ],
  "capabilities": [],
  "permissions": {
    "host_capabilities": [],
    "filesystem": {
      "mode": "none",
      "paths": []
    },
    "network": {
      "mode": "none"
    }
  },
  "autostart": false,
  "auto_reload": false
}
