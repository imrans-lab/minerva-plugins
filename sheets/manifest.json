{
  "id": "sheets",
  "name": "Sheets",
  "version": "0.1.0",
  "description": "Spreadsheet editor with formulas, charts and filters. Staging extraction.",
  "host_api_version": "2",
  "release_targets": [
    "linux-x86_64",
    "linux-arm64",
    "macos-universal",
    "windows-x86_64"
  ],
  "backend": {
    "transport": "stdio",
    "entrypoint": "./sheets-plugin",
    "args": []
  },
  "setup": {
    "requires": [
      {
        "tool": "go",
        "min": "1.25"
      }
    ],
    "steps": [
      {
        "type": "go_build",
        "package": "./",
        "output": "sheets-plugin"
      }
    ]
  },
  "tools": [
    {
      "name": "minerva_sheets_create_editor",
      "executor": "backend",
      "description": "Create a new spreadsheet. Use this when asked to 'make a spreadsheet', 'create a table', or organize data into rows and columns. Returns an editor_name for subsequent operations. Next steps: use minerva_update_spreadsheet_data to populate cells, minerva_format_cells for styling, minerva_link_spreadsheet_to_note to save as a note.",
      "input_schema": {
        "properties": {
          "csv_content": {
            "description": "Optional initial CSV content to populate the spreadsheet",
            "type": "string"
          },
          "file_path": {
            "description": "Optional file path to load (CSV, TSV, XLSX, or .minsheet)",
            "type": "string"
          },
          "name": {
            "description": "Display name for the spreadsheet tab",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    }
  ],
  "ui": {
    "panels": [
      {
        "name": "sheets_panel",
        "kind": "godot_scene",
        "entry_scene": "ui/SheetsPanel.tscn",
        "scripts": [
          "ui/SheetsPanel.gd"
        ],
        "file_extensions": [
          ".minsheet",
          ".csv",
          ".tsv",
          ".xlsx"
        ],
        "save_mode": "host_owned",
        "ipc_channels": [
          "sheets.serialize",
          "sheets.deserialize",
          "sheets.collect_export",
          "sheets.apply_export"
        ]
      }
    ],
    "ipc_messages": [
      "sheets.serialize",
      "sheets.deserialize",
      "sheets.collect_export",
      "sheets.apply_export"
    ]
  },
  "editor_items": [
    {
      "id": "new_minsheet",
      "name": "New Spreadsheet",
      "panel": "sheets_panel",
      "default_filename": "untitled.minsheet"
    }
  ],
  "capabilities": [
    "project_state",
    "host_owned_save",
    "project_export"
  ],
  "project_file": {
    "serialize_channel": "sheets.serialize",
    "deserialize_channel": "sheets.deserialize"
  },
  "project_export": {
    "collect_channel": "sheets.collect_export",
    "apply_channel": "sheets.apply_export"
  },
  "permissions": {
    "host_capabilities": [
      "mcp.proxy:minerva_create_plugin_editor",
      "mcp.proxy:minerva_open_file",
      "mcp.proxy:minerva_sheets_update_data"
    ],
    "filesystem": {
      "mode": "none",
      "paths": []
    },
    "network": {
      "mode": "none"
    }
  },
  "autostart": false,
  "auto_reload": false
}
