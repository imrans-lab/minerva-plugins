(module D_SMA (layer F.Cu) (tedit 0)
  (descr "SMD diode, SMA (DO-214AC) package. Pin 1 = cathode (K, band end), pin 2 = anode. JLCPCB Economic-assembly friendly (e.g. SS34 C8678).")
  (tags "diode SMA DO-214AC SMD")
  (fp_text reference REF** (at 0 -2.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value D_SMA (at 0 2.6) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -2.3 -1.35) (end 2.3 -1.35) (layer F.Fab) (width 0.1))
  (fp_line (start 2.3 -1.35) (end 2.3 1.35) (layer F.Fab) (width 0.1))
  (fp_line (start 2.3 1.35) (end -2.3 1.35) (layer F.Fab) (width 0.1))
  (fp_line (start -2.3 1.35) (end -2.3 -1.35) (layer F.Fab) (width 0.1))
  (fp_line (start -3.5 -1.5) (end -3.5 1.5) (layer F.SilkS) (width 0.12))
  (fp_line (start -3.5 -1.5) (end -2.6 -1.5) (layer F.SilkS) (width 0.12))
  (fp_line (start -3.5 1.5) (end -2.6 1.5) (layer F.SilkS) (width 0.12))
  (fp_line (start -3.7 -1.8) (end 3.7 -1.8) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.7 -1.8) (end 3.7 1.8) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.7 1.8) (end -3.7 1.8) (layer F.CrtYd) (width 0.05))
  (fp_line (start -3.7 1.8) (end -3.7 -1.8) (layer F.CrtYd) (width 0.05))
  (pad 1 smd rect (at -2.05 0) (size 2.2 1.7) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at 2.05 0) (size 2.2 1.7) (layers F.Cu F.Paste F.Mask))
)
