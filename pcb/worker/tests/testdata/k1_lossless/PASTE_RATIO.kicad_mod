(footprint "PASTE_RATIO" (layer "F.Cu")
  (pad "1" smd rect (at -3 0) (size 1.2 1.0) (layers "F.Cu" "F.Paste" "F.Mask")
    (solder_paste_margin_ratio -0.15))
  (pad "2" smd rect (at -1 0) (size 1.2 1.0) (layers "F.Cu" "F.Paste" "F.Mask")
    (solder_paste_margin_ratio 0))
  (pad "3" smd rect (at 1 0) (size 1.2 1.0) (layers "F.Cu" "F.Paste" "F.Mask")
    (solder_paste_margin -0.02))
  (pad "4" smd rect (at 3 0) (size 1.0 1.0) (layers "F.Cu" "F.Paste"))
  (pad "5" thru_hole circle (at 5 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask" "*.Paste")
    (solder_paste_margin_ratio -0.1))
)
